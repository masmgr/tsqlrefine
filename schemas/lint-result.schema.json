{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masmgr/tsqlrefine/schemas/lint-result.schema.json",
  "title": "tsqlrefine lint result",
  "type": "object",
  "required": ["tool", "version", "command", "files"],
  "properties": {
    "tool": { "const": "tsqlrefine" },
    "version": { "type": "string" },
    "command": { "const": "lint" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filePath", "diagnostics"],
        "properties": {
          "filePath": { "type": "string" },
          "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "object",
      "required": ["line", "character"],
      "properties": { "line": { "type": "integer", "minimum": 0 }, "character": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/position" }, "end": { "$ref": "#/$defs/position" } },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["range", "message", "source"],
      "properties": {
        "range": { "$ref": "#/$defs/range" }, "message": { "type": "string" },
        "severity": { "type": ["integer", "null"] }, "code": { "type": ["string", "null"] },
        "source": { "type": "string" }, "tags": { "type": ["array", "null"] },
        "data": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    }
  }
}
